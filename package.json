{
  "name": "erp-backend",
  "version": "0.2.0",
  "private": true,
  "description": "ERP SaaS backend - authentication service (NestJS + Supabase Auth)",
  "scripts": {
    "build": "node init && nest build",
    "start": "node init && nest start",
    "start:dev": "node init && nest start --watch",
    "start:prod": "node init && node dist/main",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^8.2.0",
    "helmet": "^8.0.0",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.14",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
